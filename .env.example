# Application
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
# Disable only after at least one external provider is configured. This also
# disables the native password-to-token login endpoint used by the iOS app.
AUTH_PASSWORD_ENABLED=true
# Optional public website origin for links from the app, without a trailing slash.
WEBSITE_URL=

# PostgreSQL
DATABASE_URL=postgresql://inventory:inventory@localhost:5432/inventory
# Optional SSH tunnel to a remote database. Keep the tunnel bound to loopback.
DB_TUNNEL_SSH_HOST=
DB_TUNNEL_SSH_USER=
DB_TUNNEL_SSH_PORT=22
DB_TUNNEL_IDENTITY_FILE=
DB_TUNNEL_SSH_JUMP=
DB_TUNNEL_LOCAL_HOST=127.0.0.1
DB_TUNNEL_LOCAL_PORT=15432
# Use REMOTE_HOST when PostgreSQL is reachable from the SSH server. For an
# unexposed Docker database, leave it empty and set DOCKER_CONTAINER instead.
DB_TUNNEL_REMOTE_HOST=
DB_TUNNEL_DOCKER_CONTAINER=
# Docker Swarm service name; use this instead of DOCKER_CONTAINER on Dokploy.
DB_TUNNEL_DOCKER_SERVICE=
DB_TUNNEL_REMOTE_PORT=5432
DB_TUNNEL_DATABASE_USER=inventory
DB_TUNNEL_DATABASE_NAME=inventory
# Docker Compose only. Use a long URL-safe value because it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
APP_PORT=3000

# Optional public Mapbox token. When set, Mapbox streets and satellite styles
# take precedence over the token-free MapLibre-compatible fallbacks below.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
NEXT_PUBLIC_SATELLITE_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}

# Simple password login. Production containers reject plaintext passwords.
SIMPLE_AUTH_EMAIL=admin@inventory.local
SIMPLE_AUTH_NAME=Inventory admin
SIMPLE_AUTH_PASSWORD=
# Generate with: npm run auth:hash -- "your password"
# In a Compose .env file, keep bcrypt hashes in single quotes so $ stays literal.
SIMPLE_AUTH_PASSWORD_HASH=

# Optional first DB-backed administrator. Remove the bootstrap hash after the
# administrator exists; exact behavior is documented under Authentication.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
# One-click installers may supply a random initial password with ONCE=true. The
# production entrypoint hashes it before the app loads and removes the cleartext
# process variable. Change the account password after first login; the bootstrap
# credential can no longer replace an existing database-backed account.
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_PASSWORD_ONCE=false
BOOTSTRAP_ADMIN_PASSWORD_HASH=
NATIVE_TOKEN_TTL_DAYS=30

# Optional one-click, read-only public workshop demo. Enabling it reconciles a
# dedicated organization after migrations; no public password is stored.
DEMO_ACCESS_ENABLED=false
DEMO_ORGANIZATION_SLUG=demo
DEMO_USER_EMAIL=demo@inventory.invalid

# Optional Auth0 login. Set all three values to enable the Auth0 button.
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_DOMAIN=
# Alternative to AUTH0_DOMAIN:
AUTH0_ISSUER_BASE_URL=

# Optional standards-based OpenID Connect provider. This can run alongside
# Auth0. Supabase example:
#   AUTH_OIDC_PROVIDER_ID=supabase
#   AUTH_OIDC_PROVIDER_NAME=Supabase
#   AUTH_OIDC_ISSUER=https://your-project.supabase.co/auth/v1
# The provider must return a verified email claim, and users must be
# pre-provisioned in Open Inventory with the same lowercase email address.
AUTH_OIDC_PROVIDER_ID=oidc
AUTH_OIDC_PROVIDER_NAME=OpenID Connect
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
AUTH_OIDC_SCOPES=openid email profile

# Quiet notifications. The in-app inbox is always available; every external
# channel remains opt-in per user and is inactive unless configured here.
# The built-in worker checks every 15 minutes. Serverless deployments can set it
# false and POST to /api/v1/notifications/run with the cron Bearer secret.
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_WORKER_POLL_MS=900000
NOTIFICATION_CRON_SECRET=
# Encrypts Web Push endpoint/auth material at rest. Use 32 random bytes encoded
# as base64url (or a 64-character hex key); do not reuse AUTH_SECRET.
NOTIFICATION_ENCRYPTION_KEY=

# Optional email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_EMAIL_FROM=

# Optional Web Push. Generate a VAPID pair with `npx web-push generate-vapid-keys`.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@example.com

# Optional deployment-wide team targets. URLs remain server-side and are only
# exposed to the settings UI in redacted form.
NOTIFICATION_SLACK_WEBHOOK_URL=
NOTIFICATION_TEAMS_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SIGNING_SECRET=

# Durable outgoing integration webhooks. Signing secrets are encrypted at rest;
# use an independent 32-byte key and do not reuse AUTH_SECRET or the notification
# encryption key. The built-in worker is safe to run in multiple app replicas.
WEBHOOK_ENCRYPTION_KEY=
WEBHOOK_WORKER_ENABLED=true
# Worker values are bounded to: poll 500-60000 ms, concurrency 1-20,
# timeout 1000-60000 ms, and attempts 1-20.
WEBHOOK_WORKER_POLL_MS=2000
WEBHOOK_WORKER_CONCURRENCY=4
WEBHOOK_DELIVERY_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=8
# Terminal delivery history and payload snapshots are retained for 1-365 days.
WEBHOOK_RETENTION_DAYS=30
# Keep false for public HTTPS targets. Enable only when this deployment is
# intentionally allowed to call trusted services on private networks.
WEBHOOK_ALLOW_PRIVATE_NETWORKS=false
# Required only when an external scheduler invokes POST /api/v1/webhooks/run.
WEBHOOK_CRON_SECRET=

# Storage: local or openinary
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./data/uploads
# Optional. Defaults to a .variants directory inside STORAGE_LOCAL_PATH.
IMAGE_VARIANT_CACHE_PATH=
MAX_UPLOAD_MB=25
# Object Capture .usdz models can be larger than images and require local storage.
MAX_USDZ_UPLOAD_MB=100
# Combined ARWorldMap, USDZ, and guide-image size for one room scan.
MAX_ROOM_SCAN_UPLOAD_MB=100
OPENINARY_BASE_URL=
OPENINARY_API_KEY=

# AI analysis (OpenAI or an OpenAI-compatible endpoint)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_VISION_MODEL=gpt-4.1-mini
# Optional override for multi-photo room colors, materials, and object suggestions.
OPENAI_ROOM_VISION_MODEL=
OPENAI_ROOM_VISION_TIMEOUT_MS=120000
# Web-grounded inventory enrichment uses text, saved images, and public search.
OPENAI_RESEARCH_MODEL=gpt-5.6-terra
OPENAI_RESEARCH_TIMEOUT_MS=90000
# Narrative inventory translation uses a balanced text model by default.
OPENAI_TRANSLATION_MODEL=gpt-5.6-terra
OPENAI_TRANSLATION_TIMEOUT_MS=120000
# Durable Postgres jobs are processed by the Next.js node process. Leases make
# multiple replicas safe; set ENABLED=false only when a separate worker owns it.
TRANSLATION_WORKER_ENABLED=true
TRANSLATION_WORKER_POLL_MS=2000
TRANSLATION_WORKER_CONCURRENCY=1
TRANSLATION_JOB_LEASE_SECONDS=180
TRANSLATION_JOB_MAX_ATTEMPTS=5
# Photo counting uses selectable Replicate models. Keep the token on the server
# only; never expose it through a NEXT_PUBLIC_* variable or an app build.
REPLICATE_API_TOKEN=
# Grounding DINO is the fast server default; clients can also choose YOLO World,
# SAM 2, or SAM 3. Keep production versions pinned for reproducible output.
REPLICATE_COUNT_DEFAULT_MODEL=grounding-dino
REPLICATE_GROUNDING_DINO_MODEL=adirik/grounding-dino:efd10a8ddc57ea28773327e881ce95e20cc1d734c589f7dd01d2036921ed78aa
REPLICATE_YOLO_WORLD_MODEL=ultralytics/yolov8s-worldv2:5e89b91b497fa7329dc88dbf820923190236ef7bc5a9b4aa1b7192b206656650
REPLICATE_SAM2_MODEL=meta/sam-2:fe97b453a6455861e3bac769b441ca1f1086110da7466dbb65cf1eecfd60dc83
REPLICATE_COUNT_MODEL=yodagg/sam3-image-seg:29c8e52db92a11c64f8939244d6b3a047ce2af24412b7971309008b9a61e2f6e
# Clients receive a signed job immediately and poll the same prediction. This
# deadline bounds cold starts and provider execution (30–600 seconds).
REPLICATE_COUNT_DEADLINE_SECONDS=300
# Optional dedicated HMAC secret for signed asynchronous count jobs. If empty,
# the production AUTH_SECRET is used.
REPLICATE_COUNT_JOB_SECRET=
REPLICATE_COUNT_CONFIDENCE=0.5
REPLICATE_COUNT_MAX_MASKS=100
AI_OUTPUT_LANGUAGE=English
# Per-identity paid-AI budgets. Operation-specific values override the legacy
# shared fallback below. Use 0 to disable that operation. Invalid explicit
# values also disable it until the configuration is corrected.
AI_RATE_LIMIT_PER_MINUTE=10
AI_ANALYSIS_RATE_LIMIT_PER_MINUTE=
AI_RESEARCH_RATE_LIMIT_PER_MINUTE=
AI_RECOGNITION_RATE_LIMIT_PER_MINUTE=
# Bound the metadata matches and visual fallback retained after searching the
# complete inventory (1–5000; defaults to 2000).
AI_RECOGNITION_MAX_CATALOG_ITEMS=2000
# Each of the two recognition provider calls has no automatic SDK retries and
# uses this bounded timeout so the route remains inside its 120-second budget.
OPENAI_RECOGNITION_TIMEOUT_MS=35000
AI_COUNT_RATE_LIMIT_PER_MINUTE=
AI_TRANSLATION_RATE_LIMIT_PER_MINUTE=30

# AI cover generation: openai or google
IMAGE_EDIT_PROVIDER=openai
OPENAI_IMAGE_EDIT_MODEL=gpt-image-1
GOOGLE_AI_API_KEY=
GOOGLE_IMAGE_EDIT_MODEL=gemini-2.5-flash-image
# Optional client-selectable allowlist. Entries use provider:model.
# Omit this and IMAGE_EDIT_DEFAULT_MODEL to keep the single-model behavior above.
IMAGE_EDIT_MODELS=openai:gpt-image-1,openai:gpt-image-1-mini,openai:gpt-image-1.5,openai:gpt-image-2,google:gemini-2.5-flash-image,google:gemini-3.1-flash-lite-image,google:gemini-3.1-flash-image,google:gemini-3-pro-image
IMAGE_EDIT_DEFAULT_MODEL=openai:gpt-image-1
AI_IMAGE_RATE_LIMIT_PER_HOUR=12
