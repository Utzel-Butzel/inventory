{
  "name": "open-inventory-product-video",
  "version": "1.0.0",
  "description": "22-second Open Inventory product film with a one-second intro and minimal text",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.521",
    "@remotion/fonts": "4.0.521",
    "@remotion/media": "4.0.521",
    "@remotion/tailwind-v4": "4.0.521",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.521",
    "tailwindcss": "4.0.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.521",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio --port=3120",
    "render": "remotion render src/index.ts OpenInventory out/open-inventory-product-fast.mp4 --concurrency=3",
    "still": "remotion still src/index.ts OpenInventory out/poster-fast.png --frame=74",
    "demo:seed": "node scripts/seed-local-demo.mjs && node scripts/attach-demo-photos.mjs && node scripts/attach-demo-room.mjs",
    "audio": "node scripts/create-score.mjs",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  },
  "sideEffects": [
    "*.css"
  ]
}
