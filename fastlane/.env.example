# Copy this file to fastlane/.env. The real file and all private keys are
# ignored by Git.
APP_STORE_CONNECT_API_KEY_KEY_ID=
APP_STORE_CONNECT_API_KEY_ISSUER_ID=

# Prefer an absolute path to the Team API key downloaded from App Store Connect.
APP_STORE_CONNECT_API_KEY_KEY_FILEPATH=/absolute/path/to/AuthKey_KEYID.p8

# Secret stores can provide the same key as Base64 instead of using a file.
# In that case, clear APP_STORE_CONNECT_API_KEY_KEY_FILEPATH and set both values.
# APP_STORE_CONNECT_API_KEY_KEY=
# APP_STORE_CONNECT_API_KEY_IS_KEY_CONTENT_BASE64=true

# Optional overrides.
IOS_BUILD_NUMBER=
TESTFLIGHT_CHANGELOG=

FASTLANE_SKIP_UPDATE_CHECK=true
FASTLANE_OPT_OUT_USAGE=true
LANG=en_US.UTF-8
LC_ALL=en_US.UTF-8
