require "base64"
require "shellwords"
require "tempfile"

opt_out_usage

default_platform(:ios)

REPOSITORY_ROOT = File.expand_path("..", __dir__)
IOS_PROJECT = File.join(REPOSITORY_ROOT, "ios/Inventory/Inventory.xcodeproj")
IOS_SHARED_SCHEME = File.join(
  IOS_PROJECT,
  "xcshareddata/xcschemes/Inventory.xcscheme"
)
IOS_SCHEME = "Inventory"
IOS_TARGET = "Inventory"
IOS_APP_IDENTIFIER = "de.polyxo.openinventory"
IOS_TEAM_ID = "6CXYQL7FXP"
IOS_OUTPUT_DIRECTORY = File.join(REPOSITORY_ROOT, "build/ios")

platform :ios do
  before_all do
    ensure_bundle_exec
    verify_project
  end

  private_lane :verify_project do
    missing_paths = [IOS_PROJECT, IOS_SHARED_SCHEME].reject { |path| File.exist?(path) }
    unless missing_paths.empty?
      UI.user_error!("Missing required iOS deployment files: #{missing_paths.join(', ')}")
    end

    sh(
      "xcodebuild",
      "-project",
      IOS_PROJECT,
      "-scheme",
      IOS_SCHEME,
      "-configuration",
      "Release",
      "-showBuildSettings",
      log: false
    )
  end

  private_lane :app_store_api_key do
    key_id = ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY_ID", "").strip
    issuer_id = ENV.fetch("APP_STORE_CONNECT_API_KEY_ISSUER_ID", "").strip
    key_filepath = ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY_FILEPATH", "").strip
    key_content = ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY", "").strip

    missing_variables = []
    missing_variables << "APP_STORE_CONNECT_API_KEY_KEY_ID" if key_id.empty?
    missing_variables << "APP_STORE_CONNECT_API_KEY_ISSUER_ID" if issuer_id.empty?
    unless missing_variables.empty?
      UI.user_error!("Missing App Store Connect variables: #{missing_variables.join(', ')}")
    end

    if key_filepath.empty? == key_content.empty?
      UI.user_error!(
        "Set exactly one of APP_STORE_CONNECT_API_KEY_KEY_FILEPATH or " \
        "APP_STORE_CONNECT_API_KEY_KEY"
      )
    end

    expanded_key_filepath = key_filepath.empty? ? nil : File.expand_path(key_filepath, REPOSITORY_ROOT)
    if expanded_key_filepath && !File.file?(expanded_key_filepath)
      UI.user_error!("APP_STORE_CONNECT_API_KEY_KEY_FILEPATH does not point to a file")
    end

    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: expanded_key_filepath,
      key_content: key_content.empty? ? nil : key_content,
      is_key_content_base64: ENV.fetch(
        "APP_STORE_CONNECT_API_KEY_IS_KEY_CONTENT_BASE64",
        "false"
      ).casecmp?("true")
    )
  end

  private_lane :validated_build_number do |options|
    build_number = options[:value].to_s.strip
    unless build_number.match?(/\A[1-9]\d*\z/)
      UI.user_error!("The iOS build number must be a positive integer")
    end
    build_number
  end

  private_lane :build_ipa do |options|
    build_number = validated_build_number(value: options[:build_number])
    xcodebuild_arguments = [
      "-allowProvisioningUpdates",
      "CURRENT_PROJECT_VERSION=#{build_number}"
    ]
    temporary_auth_key = nil

    begin
      api_key = options[:api_key]
      if api_key
        key_content = api_key.fetch(:key)
        if api_key[:is_key_content_base64]
          begin
            key_content = Base64.strict_decode64(key_content.gsub(/\s+/, ""))
          rescue ArgumentError
            UI.user_error!("The Base64 App Store Connect API key is invalid")
          end
        end

        temporary_auth_key = Tempfile.new(["AuthKey_", ".p8"])
        temporary_auth_key.binmode
        temporary_auth_key.chmod(0o600)
        temporary_auth_key.write(key_content)
        temporary_auth_key.flush

        xcodebuild_arguments.concat(
          [
            "-authenticationKeyPath",
            Shellwords.escape(temporary_auth_key.path),
            "-authenticationKeyID",
            Shellwords.escape(api_key.fetch(:key_id)),
            "-authenticationKeyIssuerID",
            Shellwords.escape(api_key.fetch(:issuer_id))
          ]
        )
      end

      provisioning_profile = ENV.fetch("IOS_PROVISIONING_PROFILE", "").strip
      export_signing = if provisioning_profile.empty?
                         { signingStyle: "automatic" }
                       else
                         {
                           signingStyle: "manual",
                           signingCertificate: "Apple Distribution",
                           provisioningProfiles: { IOS_APP_IDENTIFIER => provisioning_profile }
                         }
                       end

      build_app(
        project: IOS_PROJECT,
        scheme: IOS_SCHEME,
        configuration: "Release",
        clean: true,
        archive_path: File.join(
          IOS_OUTPUT_DIRECTORY,
          "Inventory-#{build_number}.xcarchive"
        ),
        derived_data_path: File.join(IOS_OUTPUT_DIRECTORY, "DerivedData"),
        buildlog_path: File.join(IOS_OUTPUT_DIRECTORY, "logs"),
        output_directory: IOS_OUTPUT_DIRECTORY,
        output_name: "Inventory-#{build_number}.ipa",
        xcargs: xcodebuild_arguments.join(" "),
        export_team_id: IOS_TEAM_ID,
        export_options: {
          # Fastlane 2.238.0 still validates the legacy name. Xcode 26 accepts it
          # as the backwards-compatible alias for `app-store-connect`.
          method: "app-store",
          destination: "export",
          manageAppVersionAndBuildNumber: false,
          teamID: IOS_TEAM_ID,
          stripSwiftSymbols: true,
          uploadSymbols: true
        }.merge(export_signing)
      )
    ensure
      temporary_auth_key&.close!
    end
  end

  desc "Register the bundle ID and verify its App Store Connect record"
  lane :setup do
    app_store_api_key
    bundle_id = Spaceship::ConnectAPI::BundleId.find(IOS_APP_IDENTIFIER)
    unless bundle_id
      Spaceship::ConnectAPI::BundleId.create(
        name: "Open Inventory", platform: "IOS", identifier: IOS_APP_IDENTIFIER
      )
    end
    app = Spaceship::ConnectAPI::App.find(IOS_APP_IDENTIFIER)
    unless app
      UI.user_error!(
        "Bundle ID is registered. Create Open Inventory in https://appstoreconnect.apple.com " \
        "with bundle ID/SKU #{IOS_APP_IDENTIFIER}, primary language German and platform iOS, " \
        "then rerun ios setup. Apple does not support app-record creation with an API key."
      )
    end
    UI.success("App Store Connect record ready for #{IOS_APP_IDENTIFIER}")
  end

  desc "Upload store text as a draft without submitting for review"
  lane :metadata do
    api_key = app_store_api_key
    privacy_url = ENV.fetch("APP_PRIVACY_URL", "").strip
    UI.user_error!("Set APP_PRIVACY_URL to the published app privacy policy") unless privacy_url.start_with?("https://")
    upload_to_app_store(
      api_key: api_key,
      app_identifier: IOS_APP_IDENTIFIER,
      app_version: get_version_number(xcodeproj: IOS_PROJECT, target: IOS_TARGET, configuration: "Release"),
      metadata_path: File.join(REPOSITORY_ROOT, "fastlane/metadata/ios"),
      privacy_url: { "default" => privacy_url },
      skip_binary_upload: true,
      skip_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
      run_precheck_before_submit: false,
      force: true
    )
  end

  desc "Upload captured iOS screenshots without submitting for review"
  lane :screenshots do
    api_key = app_store_api_key
    upload_to_app_store(
      api_key: api_key,
      app_identifier: IOS_APP_IDENTIFIER,
      metadata_path: File.join(REPOSITORY_ROOT, "fastlane/metadata/ios"),
      screenshots_path: File.join(REPOSITORY_ROOT, "fastlane/screenshots/ios"),
      skip_binary_upload: true,
      skip_metadata: true,
      overwrite_screenshots: false,
      submit_for_review: false,
      run_precheck_before_submit: false,
      force: true
    )
  end

  desc "Validate the local Xcode project and shared deployment scheme"
  lane :check do
    UI.success("The iOS project and shared deployment scheme are valid")
  end

  desc "Build a signed App Store IPA without uploading it"
  lane :build do
    build_number = ENV.fetch("IOS_BUILD_NUMBER", "").strip
    build_number = get_build_number(xcodeproj: IOS_PROJECT) if build_number.empty?
    api_key = ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY_ID", "").strip.empty? ? nil : app_store_api_key
    build_ipa(build_number: build_number, api_key: api_key)
  end

  desc "Build and upload the next iOS build to TestFlight"
  lane :deploy do
    api_key = app_store_api_key
    version = get_version_number(
      xcodeproj: IOS_PROJECT,
      target: IOS_TARGET,
      configuration: "Release"
    )
    latest_build_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: IOS_APP_IDENTIFIER,
      version: version,
      initial_build_number: 0
    ).to_i

    requested_build_number = ENV.fetch("IOS_BUILD_NUMBER", "").strip
    build_number = if requested_build_number.empty?
                     (latest_build_number + 1).to_s
                   else
                     validated_build_number(value: requested_build_number)
                   end

    if build_number.to_i <= latest_build_number
      UI.user_error!(
        "IOS_BUILD_NUMBER must be greater than the latest TestFlight build " \
        "(#{latest_build_number})"
      )
    end

    ipa = build_ipa(build_number: build_number, api_key: api_key)
    changelog = ENV.fetch("TESTFLIGHT_CHANGELOG", "").strip
    changelog = nil if changelog.empty?
    upload_to_testflight(
      api_key: api_key,
      app_identifier: IOS_APP_IDENTIFIER,
      ipa: ipa,
      changelog: changelog,
      distribute_external: false,
      notify_external_testers: false,
      skip_waiting_for_build_processing: true
    )
  end
end

platform :android do
  before_all do
    ensure_bundle_exec
  end

  desc "Build the signed Android App Bundle locally"
  lane :build do
    sh("node", File.join(REPOSITORY_ROOT, "scripts/android.mjs"), "bundle")
    sh("python3", File.join(REPOSITORY_ROOT, "scripts/verify-android-bundle.py"))
  end

  desc "Upload a signed bundle to the internal Play track as a draft"
  lane :deploy do
    key = ENV.fetch("GOOGLE_PLAY_JSON_KEY", "").strip
    UI.user_error!("Set GOOGLE_PLAY_JSON_KEY to your Play service-account JSON file") if key.empty?
    key = File.expand_path(key, REPOSITORY_ROOT)
    UI.user_error!("GOOGLE_PLAY_JSON_KEY file is missing") unless File.file?(key)
    version_code = ENV.fetch("ANDROID_VERSION_CODE", "").strip
    UI.user_error!("Set a new ANDROID_VERSION_CODE before each upload") unless version_code.match?(/\A[1-9]\d*\z/)
    build
    upload_to_play_store(
      package_name: "de.polyxo.openinventory",
      json_key: key,
      aab: File.join(REPOSITORY_ROOT, "android/app/build/outputs/bundle/release/app-release.aab"),
      mapping: File.join(REPOSITORY_ROOT, "android/app/build/outputs/mapping/release/mapping.txt"),
      metadata_path: File.join(REPOSITORY_ROOT, "fastlane/metadata/android"),
      track: "internal",
      release_status: "draft",
      skip_upload_images: false,
      skip_upload_screenshots: false
    )
  end
end
