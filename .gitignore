# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.playwright-cli/
/output/

# next.js
/.next/
/.vinext/
/out/
/next-env.d.ts

# misc
.DS_Store
*.pem
*.p8
*.p12
*.mobileprovision

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/
/screenshots/
/tsconfig.tsbuildinfo

# Xcode user/build state
**/xcuserdata/
**/*.xcuserstate
**/DerivedData/

# Fastlane state and generated artifacts
/build/ios/
/vendor/bundle/
/fastlane/report.xml
/fastlane/Preview.html
/fastlane/screenshots/
/fastlane/test_output/

# persistent local uploads
/data/uploads/*
!/data/uploads/.gitkeep
