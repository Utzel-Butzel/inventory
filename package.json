    "test:recognition": "node --experimental-strip-types --test tests/inventory-recognition-contract.test.mjs tests/inventory-recognition-migration.test.mjs",
    "test:covers": "node --experimental-strip-types --experimental-loader ./tests/support/typescript-paths-loader.mjs --test tests/cover-generation.test.mjs",
    "test:locations": "node --experimental-strip-types --test tests/spatial-containment.test.mjs tests/client-media-location.test.mjs",
    "test:labels": "node --experimental-strip-types --experimental-loader ./tests/support/typescript-paths-loader.mjs --test tests/resource-short-link.test.mjs tests/label-setup-contract.test.mjs",
    "test:translations": "node --experimental-strip-types --test tests/translation-contract.test.mjs",
