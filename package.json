    "lucide-react": "^0.468.0",
    "maplibre-gl": "^6.3.0",
    "next": "16.3.0",
    "next-auth": "^5.0.0-beta.30",
    "next-i18next": "^16.0.10",
    "nodemailer": "^8.0.11",
    "openai": "^7.4.0",
    "pdfkit": "^0.17.2",
    "postgres": "^3.4.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.11",
    "replicate": "^1.4.0",
