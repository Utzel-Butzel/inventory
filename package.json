    "test:notifications": "node --experimental-strip-types --experimental-loader ./tests/support/typescript-paths-loader.mjs --test tests/notification-policy.test.mjs",
    "test:deployment": "node --test tests/bootstrap-credential.test.mjs",
    "test:webhooks": "node --experimental-strip-types --test tests/webhook-contract.test.mjs",
    "test:exports": "node --experimental-strip-types --test tests/inventory-export.test.mjs",
